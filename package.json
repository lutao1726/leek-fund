{
  "name": "leek-fund",
  "displayName": "韭菜盒子",
  "description": "韭菜盒子，VSCode 里也可以看股票实时数据，做最好用的投资插件",
  "version": "3.23.6",
  "author": "Nicky Lao <giscafer@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeekHub/leek-fund"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "stock",
    "LeekFund",
    "股票",
    "韭菜盒子",
    "同花顺",
    "东方财富"
  ],
  "publisher": "giscafer",
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "enableProposedAPI": false,
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:leek-fund.refreshStock",
    "onCommand:leek-fund.stockWindVane",
    "onView:leekFundView.stock",
    "onView:leekFundView.news",
    "onView:leekFundView.binance",
    "onView:leekFundView.forex",
    "onView:leekFundView.settings",
    "onCommand:leek-fund.toggleStatusBarIconVisibility",
    "onView:leekFundView.flashNews"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leekFundMenu",
          "title": "LeekFund",
          "icon": "resources/leekfund.svg"
        }
      ],
      "panel": [
        {
          "id": "leekFundNews",
          "title": "LeekFund News",
          "icon": "resources/leekfund.svg"
        }
      ]
    },
    "views": {
      "leekFundMenu": [
        {
          "id": "leekFundView.stock",
          "name": "Stock",
          "when": "config.leek-fund.sidebarStockEnabled"
        },
        {
          "id": "leekFundView.news",
          "name": "XueQiu News",
          "when": "config.leek-fund.sidebarNewsEnabled"
        },
        {
          "id": "leekFundView.binance",
          "name": "Binance",
          "when": "config.leek-fund.sidebarBinanceEnabled",
          "visibility": "hidden"
        },
        {
          "id": "leekFundView.forex",
          "name": "Forex",
          "when": "config.leek-fund.sidebarForexEnabled",
          "visibility": "hidden"
        },
        {
          "id": "leekFundView.settings",
          "visibility": "visible",
          "name": "Settings",
          "when": "config.leek-fund.sidebarSettingsEnabled"
        },
        {
          "id": "leekFundView.agent",
          "name": "LeekAgent",
          "when": "config.leek-fund.sidebarAgentEnabled",
          "type": "webview"
        }
      ],
      "leekFundNews": [
        {
          "id": "leekFundView.flashNews",
          "name": "LeekFund News",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "leek-fund.configureXuanGuBaoAccount",
        "title": "Leek: 配置选股宝账号（安全存储）"
      },
      {
        "command": "leek-fund.clearXuanGuBaoAccount",
        "title": "Leek: 清除选股宝账号"
      },
      {
        "command": "leek-fund.openAiConfig",
        "title": "Leek: 打开 AI 配置管理",
        "icon": "$(gear)"
      },
      {
        "command": "leek-fund.sortStock",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "leek-fund.addStock",
        "title": "添加股票",
        "icon": "$(add)"
      },
      {
        "command": "leek-fund.setStockPrice",
        "title": "设置股票成本价",
        "icon": {
          "light": "resources/light/amount.svg",
          "dark": "resources/dark/amount.svg"
        }
      },
      {
        "command": "leek-fund.leekCenterView",
        "title": "韭菜中心",
        "icon": "$(home)"
      },
      {
        "command": "leek-fund.refreshStock",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "leek-fund.setStockTop",
        "title": "股票置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "leek-fund.setStockIndustryTop",
        "title": "板块置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "leek-fund.setStockUp",
        "title": "股票上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "leek-fund.setStockDown",
        "title": "股票下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "leek-fund.deleteStock",
        "title": "删除股票"
      },
      {
        "command": "leek-fund.aiStockAnalysis",
        "title": "AI分析股票(供AI分析的内容有该股票的复权日线数据+雪球资讯+韭研公社)",
        "icon": "$(lightbulb)"
      },
      {
        "command": "leek-fund.addStockToBar",
        "title": "添加至状态栏"
      },
      {
        "command": "leek-fund.stockTrendPic",
        "title": "股票走势（图片版）"
      },
      {
        "command": "leek-fund.viewFundFlow",
        "title": "资金流向",
        "icon": {
          "light": "resources/light/flow.svg",
          "dark": "resources/dark/flow.svg"
        }
      },
      {
        "command": "leek-fund.refreshFollow",
        "title": "刷新关注列表",
        "icon": "$(refresh)"
      },
      {
        "command": "leek-fund.toggleFlashNews",
        "title": "启用/关闭 OUTPUT Flash News",
        "icon": {
          "light": "resources/light/news.svg",
          "dark": "resources/dark/news.svg"
        }
      },
      {
        "command": "leek-fund.addNews",
        "title": "添加关注雪球用户",
        "icon": "$(add)"
      },
      {
        "command": "leek-fund.viewUserTimeline",
        "title": "查看动态（无头像）"
      },
      {
        "command": "leek-fund.deleteUser",
        "title": "取消关注"
      },
      {
        "command": "leek-fund.addBinancePair",
        "title": "添加交易对",
        "icon": "$(add)"
      },
      {
        "command": "leek-fund.deletePair",
        "title": "删除交易对"
      },
      {
        "command": "leek-fund.refreshBinance",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "leek-fund.setPairTop",
        "title": "交易对置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "leek-fund.refreshForex",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "leek-fund.toggleStatusBarVisibility",
        "title": "LeekFund: Toggle Status Bar Visibility"
      },
      {
        "command": "leek-fund.toggleStatusBarIconVisibility",
        "title": "LeekFund: Toggle Status Bar Icon Visibility"
      },
      {
        "command": "leek-fund.toggleStockBarVisibility",
        "title": "LeekFund: Toggle Stock Bar Visibility"
      },
      {
        "command": "leek-fund.binanceSort",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "leek-fund.xuangubaoNews",
        "title": "选股宝快讯",
        "icon": {
          "light": "resources/light/news.svg",
          "dark": "resources/dark/news.svg"
        }
      },
      {
        "command": "leek-fund.stockWindVane",
        "title": "选股风向标",
        "icon": "$(graph)"
      },
      {
        "command": "leek-fund.addStockGroup",
        "title": "LeekFund: 新增股票分组",
        "icon": "$(new-folder)"
      },
      {
        "command": "leek-fund.renameStockGroup",
        "title": "LeekFund: 重命名分组"
      },
      {
        "command": "leek-fund.deleteStockGroup",
        "title": "LeekFund: 删除分组"
      },
      {
        "command": "leek-fund.toggleStockGroups",
        "title": "LeekFund: 切换市场分类 / 自定义分组"
      },
      {
        "command": "leek-fund.moveStockToGroup",
        "title": "LeekFund: 移动到分组…"
      },
      {
        "command": "leek-fund.locateWatchlist",
        "title": "LeekFund: 自选快速定位",
        "icon": "$(search)"
      },
      {
        "command": "leek-fund.sortStockBy",
        "title": "LeekFund: 选择股票排序方式",
        "icon": "$(list-ordered)"
      },
      {
        "command": "leek-fund.openPortfolio",
        "title": "LeekFund: 资产管理中心",
        "icon": "$(pie-chart)"
      },
      {
        "command": "leek-fund.openResearch",
        "title": "LeekFund: AI 研究与分析历史",
        "icon": "$(lightbulb)"
      },
      {
        "command": "leek-fund.openDailySummary",
        "title": "LeekFund: 今日摘要",
        "icon": "$(dashboard)"
      },
      {
        "command": "leek-fund.openLearning",
        "title": "LeekFund: 学习专栏",
        "icon": "$(book)"
      },
      {
        "command": "leek-fund.inspectPortfolio",
        "title": "LeekFund: AI 持仓巡检",
        "icon": "$(shield)"
      },
      {
        "command": "leek-fund.exportPortfolio",
        "title": "LeekFund: 导出持仓账本 JSON"
      },
      {
        "command": "leek-fund.importPortfolio",
        "title": "LeekFund: 导入持仓账本 JSON"
      },
      {
        "command": "leek-fund.openPresentationSettings",
        "title": "LeekFund: 个性化设置",
        "icon": "$(paintcan)"
      },
      {
        "command": "leek-fund.flash-news-show",
        "title": "LeekFund: 打开 LeekFund News",
        "icon": "$(megaphone)"
      },
      {
        "command": "leek-fund.openSectorBoards",
        "title": "LeekFund: 板块行情",
        "icon": "$(list-tree)"
      },
      {
        "command": "leek-fund.openMarketCloudMap",
        "title": "LeekFund: 大盘云图",
        "icon": "$(dashboard)"
      },
      {
        "command": "leek-fund.openStockChanges",
        "title": "LeekFund: 个股异动",
        "icon": "$(pulse)"
      },
      {
        "command": "leek-fund.openAgent",
        "title": "LeekFund: 打开 LeekAgent",
        "icon": "$(sparkle)"
      },
      {
        "command": "leek-fund.agentExplain",
        "title": "LeekAgent 解读标的",
        "icon": "$(lightbulb)"
      }
    ],
    "keybindings": [
      {
        "command": "leek-fund.toggleStatusBarVisibility",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "leek-fund.locateWatchlist",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      },
      {
        "command": "leek-fund.openSectorBoards",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "leek-fund.refreshStock",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.sortStockBy",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.addStock",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.viewFundFlow",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.leekCenterView",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.setStockPrice",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.refreshFollow",
          "when": "view == leekFundView.news",
          "group": "navigation"
        },
        {
          "command": "leek-fund.toggleFlashNews",
          "when": "view == leekFundView.news",
          "group": "navigation"
        },
        {
          "command": "leek-fund.addNews",
          "when": "view == leekFundView.news",
          "group": "navigation"
        },
        {
          "command": "leek-fund.refreshBinance",
          "when": "view == leekFundView.binance",
          "group": "navigation"
        },
        {
          "command": "leek-fund.addBinancePair",
          "when": "view == leekFundView.binance",
          "group": "navigation"
        },
        {
          "command": "leek-fund.binanceSort",
          "when": "view == leekFundView.binance",
          "group": "navigation"
        },
        {
          "command": "leek-fund.refreshForex",
          "when": "view == leekFundView.forex",
          "group": "navigation"
        },
        {
          "command": "leek-fund.addStockGroup",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.locateWatchlist",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.openPortfolio",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "leek-fund.toggleStockGroups",
          "when": "view == leekFundView.stock",
          "group": "groups"
        },
        {
          "command": "leek-fund.openPresentationSettings",
          "when": "view == leekFundView.stock",
          "group": "settings"
        }
      ],
      "view/item/context": [
        {
          "command": "leek-fund.setStockTop",
          "when": "view == leekFundView.stock && viewItem != category  && viewItem!=nodata && viewItem != industry && viewItem != stockGroup && viewItem != holdingGroup",
          "group": "group1"
        },
        {
          "command": "leek-fund.setStockIndustryTop",
          "when": "view == leekFundView.stock && viewItem == industry",
          "group": "group1"
        },
        {
          "command": "leek-fund.setStockUp",
          "when": "view == leekFundView.stock && viewItem != category  && viewItem!=nodata && viewItem != industry && viewItem != stockGroup && viewItem != holdingGroup",
          "group": "group1"
        },
        {
          "command": "leek-fund.setStockDown",
          "when": "view == leekFundView.stock && viewItem != category  && viewItem!=nodata && viewItem != industry && viewItem != stockGroup && viewItem != holdingGroup",
          "group": "group1"
        },
        {
          "command": "leek-fund.stockTrendPic",
          "when": "view == leekFundView.stock  && viewItem != category && viewItem!=nodata && viewItem != industry && viewItem != stockGroup && viewItem != holdingGroup",
          "group": "group2"
        },
        {
          "command": "leek-fund.setStockTop",
          "when": "view == leekFundView.stock && viewItem != category && viewItem!=nodata && viewItem != industry && viewItem != stockGroup && viewItem != holdingGroup",
          "group": "inline"
        },
        {
          "command": "leek-fund.setStockIndustryTop",
          "when": "view == leekFundView.stock && viewItem == industry",
          "group": "inline"
        },
        {
          "command": "leek-fund.setStockUp",
          "when": "view == leekFundView.stock && viewItem != category && viewItem!=nodata && viewItem != industry && viewItem != stockGroup && viewItem != holdingGroup",
          "group": "inline"
        },
        {
          "command": "leek-fund.setStockDown",
          "when": "view == leekFundView.stock && viewItem != category && viewItem!=nodata && viewItem != industry && viewItem != stockGroup && viewItem != holdingGroup",
          "group": "inline"
        },
        {
          "command": "leek-fund.aiStockAnalysis",
          "when": "view == leekFundView.stock  && (viewItem == aStock || viewItem == hkStock || viewItem == usStock)",
          "group": "inline"
        },
        {
          "command": "leek-fund.deleteStock",
          "when": "view == leekFundView.stock  && viewItem != category  && viewItem != industry && viewItem != stockGroup && viewItem != holdingGroup",
          "group": "group5"
        },
        {
          "command": "leek-fund.addStockToBar",
          "when": "view == leekFundView.stock  && viewItem != category  && viewItem != industry && viewItem != stockGroup && viewItem != holdingGroup",
          "group": "group6"
        },
        {
          "command": "leek-fund.deletePair",
          "when": "view == leekFundView.binance  && viewItem != category",
          "group": "group0"
        },
        {
          "command": "leek-fund.setPairTop",
          "when": "view == leekFundView.binance",
          "group": "inline"
        },
        {
          "command": "leek-fund.setPairTop",
          "when": "view == leekFundView.binance",
          "group": "group1"
        },
        {
          "command": "leek-fund.viewUserTimeline",
          "when": "view == leekFundView.news",
          "group": "group0"
        },
        {
          "command": "leek-fund.deleteUser",
          "when": "view == leekFundView.news",
          "group": "group1"
        },
        {
          "command": "leek-fund.xuangubaoNews",
          "when": "view == leekFundView.news",
          "group": "navigation"
        },
        {
          "command": "leek-fund.addStock",
          "when": "view == leekFundView.stock && viewItem == stockGroup",
          "group": "inline"
        },
        {
          "command": "leek-fund.renameStockGroup",
          "when": "view == leekFundView.stock && viewItem == stockGroup",
          "group": "groups"
        },
        {
          "command": "leek-fund.deleteStockGroup",
          "when": "view == leekFundView.stock && viewItem == stockGroup",
          "group": "groups"
        },
        {
          "command": "leek-fund.moveStockToGroup",
          "when": "view == leekFundView.stock && viewItem != stockGroup && viewItem != holdingGroup && viewItem != category && viewItem != industry",
          "group": "groups"
        },
        {
          "command": "leek-fund.agentExplain",
          "when": "view == leekFundView.stock && (viewItem == aStock || viewItem == hkStock || viewItem == usStock)",
          "group": "inline@9"
        }
      ],
      "editor/title": [
        {
          "command": "leek-fund.openAgent",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "properties": {
        "leek-fund.stocks": {
          "type": "array",
          "default": [
            "sh000001",
            "sh000300",
            "sh000016",
            "sh000688",
            "hk03690",
            "hk00700",
            "usr_ixic",
            "usr_dji",
            "usr_inx",
            "nf_IF0",
            "nf_IH0",
            "nf_IC0",
            "nf_IM0",
            "hf_OIL",
            "hf_CHA50CFD"
          ],
          "description": "配置需要监控的股票代码（建议通过界面新增）"
        },
        "leek-fund.stockPrice": {
          "type": "object",
          "default": {},
          "description": "股票持仓金额（不建议手填，格式错误影响功能）"
        },
        "leek-fund.stockHeldTipShow": {
          "type": "boolean",
          "default": false,
          "description": "是否开启股票持仓提示"
        },
        "leek-fund.binance": {
          "type": "array",
          "default": [
            "BTC_USDT",
            "ETH_USDT",
            "EOS_USDT"
          ],
          "description": "配置需要监控的交易对（建议通过界面新增）"
        },
        "leek-fund.stocksRemind": {
          "type": "object",
          "description": "股票涨跌提醒，支持价格、涨跌幅。"
        },
        "leek-fund.statusBarStock": {
          "type": "array",
          "default": [
            "sh000001"
          ],
          "description": "状态栏展示的股票（建议通过界面选择设置，必须是在股票代码已设置存在）",
          "maxItems": 8
        },
        "leek-fund.showStockIndustry": {
          "type": "boolean",
          "default": false,
          "description": "自选股列表是否显示股票行业"
        },
        "leek-fund.groupStockByIndustry": {
          "type": "boolean",
          "default": false,
          "description": "A股自选股是否按行业分组"
        },
        "leek-fund.interval": {
          "type": "number",
          "default": 5000,
          "description": "配置轮询请求最新数据的时间间隔，单位：毫秒（最小轮询间隔是3秒）"
        },
        "leek-fund.riseColor": {
          "type": "string",
          "default": "white",
          "description": "股票涨的颜色"
        },
        "leek-fund.fallColor": {
          "type": "string",
          "default": "#C9AD06",
          "description": "股票跌的颜色"
        },
        "leek-fund.hideStatusBarStock": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏股票状态栏"
        },
        "leek-fund.hideStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏状态栏"
        },
        "leek-fund.hideStatusBarIcon": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏状态栏图标"
        },
        "leek-fund.newsUserIds": {
          "type": "array",
          "default": [
            "5124430882",
            "1287305957",
            "1632326933"
          ],
          "description": "雪球用户id（进入雪球用户首页，复制/u/后的数字即可，比如 https://xueqiu.com/u/5124430882 链接的 5124430882）"
        },
        "leek-fund.xueqiuCookie": {
          "type": "string",
          "default": "",
          "description": "由于防爬虫机制，需要用户设置雪球网站cookie"
        },
        "leek-fund.showEarnings": {
          "type": [
            "boolean",
            "number"
          ],
          "default": 1,
          "description": "显示/隐藏盈亏（1显示，0隐藏）"
        },
        "leek-fund.iconType": {
          "type": "string",
          "default": "arrow",
          "description": "股票涨跌图标（目前支持两种：arrow 和 food）"
        },
        "leek-fund.stockSort": {
          "type": "number",
