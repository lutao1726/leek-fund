  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "lint": "eslint src --fix --ext ts  --ignore-path .gitignore",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run lint && yarn run compile",
    "test": "node ./out/_test/runTest.js",
    "deploy": "vsce publish --yarn",
    "package": "vsce package --yarn -o ./",
    "commitmsg": "commitlint -e $GIT_PARAMS",
    "release": "standard-version",
    "check": "tsc --noEmit -p ./ && tsc --noEmit -p template-packages/leek-center",
    "test:core": "node scripts/test-core.js",
    "test:market": "node scripts/test-market.js",
    "test:research": "node scripts/test-research.js",
    "test:summary": "node scripts/test-daily-summary.js",
    "test:dashboard": "node scripts/test-dashboard.js",
    "build:webview": "npm --prefix ./template-packages/leek-center run build --ignore-scripts",
    "build": "npm run compile && npm run build:webview",
    "test:performance": "node scripts/test-performance.js",
    "test:ui": "npm --prefix ./template-packages/leek-center test -- --watchAll=false --runInBand",
    "test:presentation": "node scripts/test-presentation.js",
    "test:agent": "node scripts/test-agent.js",
    "test:agent-skills": "node scripts/test-agent-skills.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint",
      "commit-msg": "npm run commitmsg"
    }
  },
